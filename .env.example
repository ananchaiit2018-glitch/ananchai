# เชื่อมฐานข้อมูล Neon ผ่าน Vercel (Storage > Neon) แล้ว Vercel จะใส่ค่านี้ให้อัตโนมัติ
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require

# รหัสผู้ดูแล (แอดมิน) — ใช้แก้ไขข้อมูลและรับแจ้งเตือน ตั้งเฉพาะบน Vercel อย่าเขียนลงโค้ด
APP_PASSCODE=

# ใช้เซ็นโทเคนเข้าสู่ระบบ ยาวอย่างน้อย 16 ตัว สุ่มได้ด้วย: openssl rand -hex 32
SESSION_SECRET=

# รหัสสำหรับ "กำลังพล" (ดูอย่างเดียว) ตั้งเพื่อให้กำลังพลเข้าดูแดชบอร์ดได้
# ถ้าไม่ตั้ง จะมีเฉพาะแอดมินที่เข้าได้ (ค่าเริ่มต้นของระบบคือปิด: ไม่มีรหัส = มองไม่เห็นข้อมูลใดๆ)
VIEWER_CODE=

# (ไม่แนะนำ) ตั้งเป็น 1 เพื่อให้ใครก็ได้ที่มีลิงก์ดูแดชบอร์ดได้โดยไม่ต้องใส่รหัส
# PUBLIC_VIEW=1

# (ไม่บังคับ) ทดสอบในเครื่องโดยไม่ต้องมีฐานข้อมูลจริง ข้อมูลหายเมื่อรีสตาร์ต
# USE_MEMORY_DB=1
